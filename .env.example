# ── CloudPilot AI — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.

# Supabase Configuration (local development defaults)
SUPABASE_URL="http://localhost:54321"
SUPABASE_PUBLISHABLE_KEY="mock-anon-key"
VITE_SUPABASE_URL="http://localhost:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="mock-anon-key"
VITE_SUPABASE_PROJECT_ID="local"

# Anthropic API Key (required)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# AI Models (optional — defaults shown)
ANTHROPIC_MODEL="claude-sonnet-4-6"
ANTHROPIC_DEEP_MODEL="claude-opus-5"

# Dedicated vault key (>= 32 chars). Do not reuse the service-role key.
CREDENTIAL_VAULT_KEY="replace-with-a-long-random-vault-key"
# CREDENTIAL_VAULT_KEY_PREVIOUS=""  # set during rotation only

# Comma-separated browser origins. CORS is fail-closed (no localhost fallback).
ALLOWED_ORIGINS="http://localhost:8080,http://localhost:5173"

# Platform AWS credentials used only to AssumeRole into customer accounts.
# CLOUDPILOT_AWS_ACCESS_KEY_ID=""
# CLOUDPILOT_AWS_SECRET_ACCESS_KEY=""
# CLOUDPILOT_AWS_ACCOUNT_ID=""

# Off by default. When true, long-lived IAM user keys may be stored in the vault.
ENABLE_LEGACY_ACCESS_KEYS="false"

# Guardian cron shared secret (compare is constant-time).
# GUARDIAN_AUTOMATION_WEBHOOK_SECRET=""

# Stripe webhook signature secret is required in production.
# STRIPE_WEBHOOK_SECRET=""
