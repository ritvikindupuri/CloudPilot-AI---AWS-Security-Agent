# ── CloudPilot AI — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file. NEVER put secrets in VITE_* variables except the
# public Supabase anon/publishable key (protected by RLS).

# ── Frontend (Vite) — public values only ─────────────────────────────────────
VITE_SUPABASE_URL="http://localhost:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="mock-anon-key"
VITE_SUPABASE_PROJECT_ID="local"

# ── Backend / Edge Functions (server-only — DO NOT prefix with VITE_) ────────
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="mock-anon-key"
SUPABASE_SERVICE_ROLE_KEY="mock-service-role-key"
# Optional alias used by some local tooling
SUPABASE_PUBLISHABLE_KEY="mock-anon-key"

# Anthropic API Key (server-side only — never expose to the browser)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
ANTHROPIC_MODEL="claude-sonnet-4-6"
ANTHROPIC_DEEP_MODEL="claude-opus-5"

# ── Enterprise security controls ─────────────────────────────────────────────
# Exact frontend origin for CORS (no wildcards). Comma-separated not supported;
# set the single production origin, e.g. https://app.example.com
ALLOWED_ORIGIN="http://localhost:8080"

# Require temporary STS session tokens (recommended: true)
ENFORCE_STS_ONLY="true"

# Allow IAM privilege-escalation style tool calls (attack sims). Keep false in prod.
ALLOW_HIGH_RISK_IAM="false"

# Allow aws-executor to attach managed policies on AccessDenied. Keep false in prod.
ENABLE_IAM_AUTO_ELEVATION="false"
